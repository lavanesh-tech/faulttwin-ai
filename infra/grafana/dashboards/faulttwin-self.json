{
  "uid": "faulttwin-self",
  "title": "FaultTwin self-observability",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "faulttwin"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Node up (1 = reachable last cycle)",
      "datasource": {
        "type": "prometheus",
        "uid": "faulttwin-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faulttwin_node_up",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Detections per minute by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "faulttwin-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(faulttwin_detections_total[1m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Monitor cycle duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "faulttwin-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(faulttwin_monitor_cycle_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Incident recorder: pending, dropped, retries",
      "datasource": {
        "type": "prometheus",
        "uid": "faulttwin-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "faulttwin_incident_recorder_pending",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "faulttwin_incident_detections_dropped_total",
          "legendFormat": "dropped (total)"
        },
        {
          "refId": "C",
          "expr": "faulttwin_incident_store_retries_total",
          "legendFormat": "store retries (total)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests per second by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "faulttwin-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(faulttwin_http_requests_total[1m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP handler latency p99 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "faulttwin-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(faulttwin_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "description": "FaultTwin's own health. Values are measured by faulttwind; with --source synthetic the monitored cluster is simulated."
}
