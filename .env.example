# FaultTwin AI lab configuration. Copy to .env (scripts/lab-init-env.sh does this and fills in
# random passwords). .env is git-ignored; never commit real values.

# Lab cluster (docker compose)
POSTGRES_PASSWORD=change-me-superuser
FT_REPLICATION_PASSWORD=change-me-replication
FT_MONITOR_PASSWORD=change-me-monitor
FT_WORKLOAD_PASSWORD=change-me-workload

# Host ports, bound to 127.0.0.1 only
FT_PG_PRIMARY_PORT=55432
FT_PG_REPLICA1_PORT=55433
FT_PG_REPLICA2_PORT=55434

# faulttwin-monitor and the integration tests
FT_MONITOR_USER=ft_monitor
FT_MONITOR_DBNAME=postgres
FT_MONITOR_NODES=pg-primary=127.0.0.1:55432,pg-replica-1=127.0.0.1:55433,pg-replica-2=127.0.0.1:55434
FT_WORKLOAD_USER=ft_workload
